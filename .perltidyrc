# Locked defaults
-i=4
-ci=2
-nsbl
-cti=0
-sbt=1
-bt=1
-bbt=0
-sfs

# Local policy
-se               # Print errors to stderr instead of a file
-ole=unix         # Standardize on LF line endings
-bext=~           # Use ~ as backup extension instead of .bak
-l=120            # Modern line length
-pt=0             # Put whitespace inside parentheses
-tso              # Format things like 0+ and +0 without space in between
-csc -csci=20     # Add closing comments to blocks of at least 20 lines
-nbbc             # Prevent automatic blank lines before comments
